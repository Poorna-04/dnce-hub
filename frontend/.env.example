# Template for frontend/.env — copy it and fill in values for your setup:
#   cp frontend/.env.example frontend/.env

# Browser (Axios) — relative, same-origin. Hits the Next.js rewrite.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# SSR / Route Handlers / Next rewrite — Node talks to Spring directly.
# Local `next dev`:  http://localhost:8080/api/v1
# Docker Compose:    http://backend:8080/api/v1
SPRING_BASE_URL=http://localhost:8080/api/v1
