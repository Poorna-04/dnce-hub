# Template for backend/.env — copy it and fill in your own values:
#   cp backend/.env.example backend/.env
#
# backend/.env is gitignored and is where all local secrets live. It is read by:
#   - Spring Boot, via `spring.config.import` in application.yml
#   - docker-compose, via `env_file:`
#
# Real OS environment variables override anything in this file, which is how
# the server supplies production values without a .env being present at all.

# --- Database ---------------------------------------------------------------
# Local:          jdbc:postgresql://localhost:5432/dancehub
# docker-compose: jdbc:postgresql://postgres:5432/dancehub   (service name, not localhost)
# Neon:           use the POOLED connection string, and keep ?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dancehub
SPRING_DATASOURCE_USERNAME=dancehub
SPRING_DATASOURCE_PASSWORD=dancehub_dev

# --- Redis ------------------------------------------------------------------
# Local: localhost   docker-compose: redis
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Auth -------------------------------------------------------------------
# Base64-encoded 256-bit key. Generate a fresh one per environment:
#   openssl rand -base64 32
# The key previously committed in application.yml is burned — do not reuse it.
JWT_SECRET=replace-me-with-openssl-rand-base64-32

# --- Profile ----------------------------------------------------------------
# Unset locally (mvn spring-boot:run activates `dev` on its own).
# Set to `prod` on the server.
# SPRING_PROFILES_ACTIVE=prod
